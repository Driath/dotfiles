theme = TokyoNight
# Apparence
font-family = GeistMono Nerd Font
font-family = Hack Nerd Font
font-family = FiraCode Nerd Font
font-family = JetBrainsMono Nerd Font
font-family = CommitMono Nerd Font
font-family = MesloLGS Nerd Font
font-family = SauceCodePro Nerd Font
font-family = Inconsolata Nerd Font
font-family = JetBrains Mono
font-family = BlexMono Nerd Font
font-family = VictorMono Nerd Font
font-family = Iosevka Nerd Font
font-family = Maple Mono NF
font-size = 14
adjust-cell-height = 5%
background-opacity = 1
background-opacity-cells = true
cursor-style-blink = false
background-blur = 0
window-padding-x = 0
window-padding-y = 0
window-decoration = true
confirm-close-surface = false

# Shell direct, sans tmux, toujours dans ~/
working-directory = home
command = /bin/zsh -l

# Option gauche = Alt (pour raccourcis app), Option droit = caractères spéciaux
macos-option-as-alt = left

# Fix Option+Up/Down (Ghostty doesn't send CSI natively for these)
keybind = alt+up=csi:1;3A
keybind = alt+down=csi:1;3B


# ===========================================================================
# Cmd → clipboard natif macOS
# ===========================================================================
keybind = cmd+c=copy_to_clipboard
keybind = cmd+v=paste_from_clipboard

# ===========================================================================
# Windows / tabs / splits — natif Ghostty (tmux retiré)
# ===========================================================================
keybind = cmd+t=new_tab
keybind = cmd+w=close_surface
keybind = cmd+n=new_window
keybind = cmd+shift+n=new_window
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down

# Fullscreen natif macOS
keybind = cmd+f=unbind

# Font size
keybind = cmd+equal=increase_font_size:1
keybind = cmd+plus=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+zero=reset_font_size

# Quit coupé : cmd+q agit comme cmd+w (ferme une surface à la fois, jamais tout d'un coup)
keybind = cmd+q=close_surface
# Open config (Cmd+, like any macOS app)
keybind = cmd+comma=open_config
# Reload config
keybind = ctrl+shift+r=reload_config
