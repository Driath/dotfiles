theme = TokyoNight
# Apparence
font-family = GeistMono Nerd Font
font-family = Hack Nerd Font
font-family = FiraCode Nerd Font 
font-family = JetBrainsMono Nerd Font
font-family = CommitMono Nerd Font
font-family = MesloLGS Nerd Font
font-family = SauceCodePro Nerd Font
font-family = Inconsolata Nerd Font
font-family = JetBrains Mono
font-family = BlexMono Nerd Font
font-family = VictorMono Nerd Font
font-family = Iosevka Nerd Font
font-family = Maple Mono NF
font-size = 14
adjust-cell-height = 5%
background-opacity = 0.66
background-blur = 0
window-padding-x = 0
window-padding-y = 0
window-decoration = auto
confirm-close-surface = false
macos-titlebar-style = hidden

# Toujours demarrer dans tmux
command = /bin/zsh -c "$HOME/.local/bin/tmux attach || $HOME/.local/bin/tmux new-session"

# Option gauche = Alt (pour raccourcis app), Option droit = caractères spéciaux
macos-option-as-alt = left

# Fix Option+Arrow horizontal (Ghostty sends ^[b/^[f instead of CSI sequences)
keybind = alt+left=csi:1;3D
keybind = alt+right=csi:1;3C

# ===========================================================================
# Cmd → Option (Meta) pour les actions éditeur
# kitty-keys on dans tmux: seul Neovim reçoit les séquences CSI u
# ===========================================================================
keybind = cmd+s=text:\x1bs
keybind = cmd+z=text:\x1bz
keybind = cmd+shift+z=text:\x1bZ
keybind = cmd+a=text:\x1ba
keybind = cmd+x=text:\x1bx
keybind = cmd+c=text:\x1bc
keybind = cmd+v=text:\x00V
keybind = cmd+:=text:\x1b:

# ===========================================================================
# Cmd = tmux/système
# ===========================================================================

# Navigation windows
keybind = cmd+t=text:\x00c
keybind = cmd+w=text:\x00x
keybind = cmd+left=text:\x00p
keybind = cmd+right=text:\x00n
keybind = cmd+up=text:\x00(
keybind = cmd+down=text:\x00)

# Onglets AZERTY
keybind = cmd+physical:one=text:\x001
keybind = cmd+physical:two=text:\x002
keybind = cmd+physical:three=text:\x003
keybind = cmd+physical:four=text:\x004
keybind = cmd+physical:five=text:\x005

# Splits
keybind = cmd+d=text:\x00\\
keybind = cmd+shift+d=text:\x00'

# Navigation panes
keybind = cmd+alt+left=text:\x00h
keybind = cmd+alt+right=text:\x00l
keybind = cmd+alt+up=text:\x00k
keybind = cmd+alt+down=text:\x00j

# Swap windows
keybind = cmd+shift+left=text:\x00{
keybind = cmd+shift+right=text:\x00}

# Move window to another session
keybind = cmd+shift+up=text:\x00B
keybind = cmd+shift+down=text:\x00F

# Swap panes
keybind = cmd+alt+shift+left=text:\x00<
keybind = cmd+alt+shift+right=text:\x00>
keybind = cmd+alt+shift+up=text:\x00+
keybind = cmd+alt+shift+down=text:\x00_

# Zoom pane
keybind = cmd+alt+f=text:\x00z

# Rename session
keybind = cmd+r=text:\x00S

# Fullscreen
keybind = cmd+f=toggle_fullscreen

# Font size
keybind = cmd+equal=decrease_font_size:1
keybind = cmd+minus=increase_font_size:1
keybind = cmd+zero=reset_font_size

# Quit
keybind = cmd+q=quit

# Complexes: delegues a tmux (prefix + key majuscule custom)
# Cmd+N → nouvelle session
keybind = cmd+n=text:\x00N
# Cmd+E → neo-tree (Neovim)
keybind = cmd+e=text:\x1be
# Cmd+M → speech-to-text
keybind = cmd+m=text:\x00m
# Cmd+Shift+N → libre
keybind = cmd+shift+n=unbind
# Cmd+Shift+X → libre
keybind = cmd+shift+x=unbind
# Cmd+Shift+R → libre
keybind = cmd+shift+r=unbind
# Cmd+Shift+E → libre
keybind = cmd+shift+e=unbind
# Cmd+Shift+T → new window in yazi dir
keybind = cmd+shift+t=text:\x00T
# Theme picker / config editor
keybind = cmd+p=text:\x00G
keybind = cmd+shift+p=text:\x00Y
# Open config (Cmd+, like any macOS app)
keybind = cmd+comma=open_config
# Reload config
keybind = ctrl+shift+r=reload_config
