theme = TokyoNight Night
# Apparence
font-family = GeistMono Nerd Font
font-family = Hack Nerd Font
font-family = FiraCode Nerd Font 
font-family = JetBrainsMono Nerd Font
font-family = CommitMono Nerd Font
font-family = MesloLGS Nerd Font
font-family = SauceCodePro Nerd Font
font-family = Inconsolata Nerd Font
font-family = JetBrains Mono
font-family = BlexMono Nerd Font
font-family = VictorMono Nerd Font
font-family = Iosevka Nerd Font
font-family = Maple Mono NF
font-size = 14
adjust-cell-height = 5%
background-opacity = 0.66
background-opacity-cells = true
background-blur = 0
window-padding-x = 0
window-padding-y = 0
window-decoration = auto
confirm-close-surface = false
macos-titlebar-style = hidden

# Toujours demarrer dans tmux (prefer compiled version, fallback to brew)
command = /bin/zsh -c 'TMUX_BIN="${HOME}/.local/bin/tmux"; [ -x "$TMUX_BIN" ] || TMUX_BIN="$(command -v tmux)"; "$TMUX_BIN" attach || "$TMUX_BIN" new-session'

# Option gauche = Alt (pour raccourcis app), Option droit = caractères spéciaux
macos-option-as-alt = left

# Fix Option+Arrow (Ghostty sends legacy sequences instead of CSI)
keybind = alt+left=csi:1;3D
keybind = alt+right=csi:1;3C
keybind = alt+up=csi:1;3A
keybind = alt+down=csi:1;3B
# Fix Ctrl+Option+Arrow (force CSI modifier 7 = Ctrl+Alt)
keybind = ctrl+alt+left=csi:1;7D
keybind = ctrl+alt+right=csi:1;7C

# ===========================================================================
# Cmd → Option (Meta) pour les actions éditeur
# kitty-keys on dans tmux: seul Neovim reçoit les séquences CSI u
# ===========================================================================
keybind = cmd+s=text:\x1bs
keybind = cmd+z=text:\x1bz
keybind = cmd+shift+z=text:\x1bZ
keybind = cmd+a=text:\x1ba
keybind = cmd+x=text:\x1bx
keybind = cmd+c=text:\x1bc
keybind = cmd+v=text:\x00V
keybind = cmd+:=text:\x1b:

# ===========================================================================
# Cmd → bawi (via CSI user-keys interceptés par tmux root table)
# Séquences \x1b[900~ à \x1b[930~ → tmux user-keys → run-shell "bawi ..."
# ===========================================================================

# Navigation windows
keybind = cmd+t=text:\x1b[900~
keybind = cmd+w=text:\x1b[901~
keybind = cmd+left=text:\x1b[902~
keybind = cmd+right=text:\x1b[903~
keybind = cmd+up=text:\x1b[904~
keybind = cmd+down=text:\x1b[905~

# Onglets AZERTY
keybind = cmd+physical:one=text:\x1b[906~
keybind = cmd+physical:two=text:\x1b[907~
keybind = cmd+physical:three=text:\x1b[908~
keybind = cmd+physical:four=text:\x1b[909~
keybind = cmd+physical:five=text:\x1b[910~

# Splits
keybind = cmd+d=text:\x1b[911~
keybind = cmd+shift+d=text:\x1b[912~

# Navigation panes
keybind = cmd+alt+left=text:\x1b[913~
keybind = cmd+alt+right=text:\x1b[914~
keybind = cmd+alt+up=text:\x1b[915~
keybind = cmd+alt+down=text:\x1b[916~

# Swap windows
keybind = cmd+shift+left=text:\x1b[917~
keybind = cmd+shift+right=text:\x1b[918~

# Move window to another session
keybind = cmd+shift+up=text:\x1b[919~
keybind = cmd+shift+down=text:\x1b[920~

# Swap panes
keybind = cmd+alt+shift+left=text:\x1b[921~
keybind = cmd+alt+shift+right=text:\x1b[922~
keybind = cmd+alt+shift+up=text:\x1b[923~
keybind = cmd+alt+shift+down=text:\x1b[924~

# Zoom pane
keybind = cmd+alt+f=text:\x1b[925~

# Rename session
keybind = cmd+r=text:\x1b[926~

# Session create
keybind = cmd+n=text:\x1b[927~

# Fullscreen
keybind = cmd+f=toggle_fullscreen

# Font size
keybind = cmd+equal=decrease_font_size:1
keybind = cmd+minus=increase_font_size:1
keybind = cmd+zero=reset_font_size

# Quit
keybind = cmd+q=quit
# Cmd+E → neo-tree (Neovim)
keybind = cmd+e=text:\x1be
# Cmd+M → speech-to-text
keybind = cmd+m=text:\x00m
# Cmd+Shift+N → libre
keybind = cmd+shift+n=unbind
# Cmd+Shift+X → libre
keybind = cmd+shift+x=unbind
# Cmd+Shift+R → libre
keybind = cmd+shift+r=unbind
# Cmd+Shift+E → libre
keybind = cmd+shift+e=unbind
# Cmd+Shift+T → new window in yazi dir
keybind = cmd+shift+t=text:\x00T
# Cmd+P → find files (Neovim) / fzf (shell)
keybind = cmd+p=text:\x1bp
# Theme cycling
keybind = cmd+shift+l=text:\x00G
keybind = cmd+shift+k=text:\x00Y
# Open config (Cmd+, like any macOS app)
keybind = cmd+comma=open_config
# Reload config
keybind = ctrl+shift+r=reload_config

