# Apparence
font-family = JetBrainsMono Nerd Font
font-size = 14
adjust-cell-height = 5%
background-opacity = 0.83
window-padding-x = 0
window-padding-y = 0
window-decoration = auto
confirm-close-surface = false
macos-titlebar-style = hidden

# Toujours demarrer dans tmux
command = /bin/zsh -c "tmux attach || tmux new-session"

# Desactiver tabs/splits natifs (tout est dans tmux)
macos-option-as-alt = left

# Option+Shift+Arrow → Home/End horizontal, move line vertical
keybind = alt+shift+right=text:\x1bOF
keybind = alt+shift+left=text:\x1bOH
# Option+Shift+Up/Down → move line in nvim (sends Alt+arrows)
keybind = alt+shift+up=text:\x1b[1;3A
keybind = alt+shift+down=text:\x1b[1;3B

# Cmd+X → cut
keybind = cmd+x=text:\x18

# Cmd+S → save, Cmd+Z → undo, Cmd+Shift+Z → redo, Cmd+A → select all
keybind = cmd+s=text:\x13
keybind = cmd+z=text:\x1a
keybind = cmd+shift+z=text:\x12
keybind = cmd+a=text:\x01

# Keybindings simples: Cmd → prefix tmux (Ctrl+Space = \x00)
# Navigation windows
keybind = cmd+t=text:\x00c
keybind = cmd+w=text:\x00x
keybind = cmd+left=text:\x00p
keybind = cmd+right=text:\x00n
keybind = cmd+up=text:\x00(
keybind = cmd+down=text:\x00)

# Onglets AZERTY
keybind = cmd+physical:one=text:\x001
keybind = cmd+physical:two=text:\x002
keybind = cmd+physical:three=text:\x003
keybind = cmd+physical:four=text:\x004
keybind = cmd+physical:five=text:\x005

# Splits
keybind = cmd+d=text:\x00\\
keybind = cmd+shift+d=text:\x00'

# Navigation panes
keybind = cmd+alt+left=text:\x00h
keybind = cmd+alt+right=text:\x00l
keybind = cmd+alt+up=text:\x00k
keybind = cmd+alt+down=text:\x00j

# Swap windows
keybind = cmd+shift+left=text:\x00{
keybind = cmd+shift+right=text:\x00}

# Move window to another session
keybind = cmd+shift+up=text:\x00B
keybind = cmd+shift+down=text:\x00F

# Swap panes
keybind = cmd+alt+shift+left=text:\x00<
keybind = cmd+alt+shift+right=text:\x00>
keybind = cmd+alt+shift+up=text:\x00+
keybind = cmd+alt+shift+down=text:\x00_

# Zoom pane
keybind = cmd+alt+f=text:\x00z

# Rename session
keybind = cmd+r=text:\x00S

# Fullscreen
keybind = cmd+f=toggle_fullscreen

# Font size
keybind = cmd+equal=decrease_font_size:1
keybind = cmd+minus=increase_font_size:1
keybind = cmd+zero=reset_font_size

# Quit
keybind = cmd+q=quit

# Shift+Enter
keybind = shift+enter=text:\x1b[13;2u

# Complexes: delegues a tmux (prefix + key majuscule custom)
# Cmd+C → copy (Ctrl+C to nvim for visual yank, falls back to interrupt)
keybind = cmd+c=text:\x03
# Cmd+V → clipboard smart
keybind = cmd+v=text:\x00V
# Cmd+N → nouvelle session
keybind = cmd+n=text:\x00N
# Cmd+E → toggle yazi
keybind = cmd+e=text:\x00E
# Cmd+M → speech-to-text
keybind = cmd+m=text:\x00m
# Cmd+Shift+N → new file yazi
keybind = cmd+shift+n=text:\x00A
# Cmd+Shift+X → delete yazi
keybind = cmd+shift+x=text:\x00X
# Cmd+Shift+R → rename yazi
keybind = cmd+shift+r=text:\x00R
# Cmd+Shift+E → edit yazi
keybind = cmd+shift+e=text:\x00O
# Cmd+Shift+T → new window in yazi dir
keybind = cmd+shift+t=text:\x00T
# Reload config
keybind = ctrl+shift+r=reload_config
